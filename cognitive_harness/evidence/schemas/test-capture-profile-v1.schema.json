{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/euthm/superretometer/spec/schemas/test-capture-profile-v1.schema.json",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lockfiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "archive": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "locator",
        "retention"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "declared_remote": {
          "type": "string",
          "minLength": 1
        },
        "requested_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "falsifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "scope",
        "declared_remote",
        "requested_commit",
        "falsifier"
      ],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "expected_executed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "required_zero_failures": {
          "type": "boolean"
        },
        "no_skips": {
          "type": "boolean"
        },
        "required_test_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "expected_executed",
        "required_zero_failures",
        "no_skips",
        "required_test_ids"
      ],
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "counts-json/v1",
            "junit/v1",
            "unknown/v1"
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "report"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools",
        "services",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "timeout_seconds": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "redact_env": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "repo",
    "source_paths",
    "lockfiles",
    "archive",
    "claim",
    "acceptance",
    "parser",
    "environment"
  ],
  "additionalProperties": false
}
