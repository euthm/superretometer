{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cognitive-harness.org/schemas/provenance.json",
  "title": "Provenance",
  "description": "Source attribution and traceability for knowledge objects. Includes simulation and implementation provenance.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/simulation_provenance" },
    { "$ref": "#/definitions/implementation_provenance" },
    { "$ref": "#/definitions/generic_provenance" }
  ],
  "definitions": {
    "generic_provenance": {
      "properties": {
        "source": {
          "type": "string",
          "description": "Origin of the knowledge (e.g., experiment, model, decision, code_repository)"
        },
        "author": {
          "type": "string",
          "description": "Creator or responsible party"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Revision number"
        },
        "derived_from": {
          "type": ["string", "null"],
          "description": "KO ID this provenance was derived from"
        },
        "independent": {
          "type": "boolean",
          "description": "Whether this provenance is independent of other evidence chains"
        }
      },
      "required": ["source", "author"]
    },
    "simulation_provenance": {
      "allOf": [
        { "$ref": "#/definitions/generic_provenance" },
        {
          "properties": {
            "provenance_type": {
              "const": "simulation"
            },
            "simulation": {
              "type": "object",
              "required": [
                "result_artifact",
                "result_sha256",
                "run_id",
                "model_id",
                "source_commit"
              ],
              "properties": {
                "result_artifact": {
                  "type": "string",
                  "description": "Path or URL to the result file"
                },
                "result_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA256 hash of the result artifact"
                },
                "run_id": {
                  "type": "string",
                  "description": "Unique identifier for the simulation run"
                },
                "parameter_set_id": {
                  "type": "string",
                  "description": "Identifier for the parameter set used"
                },
                "build_artifact": {
                  "type": "string",
                  "description": "Path to compiled model binary or build artifact"
                },
                "model_id": {
                  "type": "string",
                  "description": "Identifier of the model used"
                },
                "source_path": {
                  "type": "string",
                  "description": "File path to model source"
                },
                "source_commit": {
                  "type": "string",
                  "description": "Git commit hash of model source"
                },
                "source_version": {
                  "type": "string",
                  "description": "Version string of model source"
                }
              }
            }
          },
          "required": ["provenance_type", "simulation"]
        }
      ]
    },
    "implementation_provenance": {
      "allOf": [
        { "$ref": "#/definitions/generic_provenance" },
        {
          "properties": {
            "provenance_type": {
              "const": "implementation"
            },
            "implementation": {
              "type": "object",
              "required": [
                "repo_remote_canonical",
                "commit"
              ],
              "properties": {
                "repo_remote_sanitized": {
                  "type": "string",
                  "description": "Observed transport locator with credentials removed. Audit trail. Never stores tokens/secrets."
                },
                "repo_remote_canonical": {
                  "type": "string",
                  "description": "Normalized repository identity (e.g., github.com/euthm/superretometer). Used for gating and comparison.",
                  "pattern": "^[a-z][a-z0-9.-]+/[a-zA-Z0-9._/-]+$"
                },
                "repo_remote_raw": {
                  "type": "string",
                  "description": "Deprecated. Renamed to repo_remote_sanitized."
                },
                "repo_remote": {
                  "type": "string",
                  "description": "Deprecated. Compatibility input normalized into repo_remote_canonical. Do not use in new claims."
                },
                "repo_path": {
                  "type": "string",
                  "description": "Local or workspace path to the repository root"
                },
                "branch": {
                  "type": "string",
                  "description": "Git branch name (contextual metadata, not revision identity). Optional; detached HEAD is valid."
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$",
                  "description": "Git commit hash (full or short). Revision identity together with repo_remote_canonical."
                },
                "worktree_clean": {
                  "type": ["boolean", "null"],
                  "description": "True=clean, False=dirty, null=unobserved. True required for PASS."
                },
                "worktree_diff_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA256 of deterministic worktree diff (staged + unstaged + untracked changes). Required when worktree_clean is False."
                },
                "submodule_pins": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string" },
                      "repo_remote_sanitized": { "type": "string", "description": "Sanitized remote URL (credentials stripped)" },
                      "repo_remote_canonical": { "type": "string", "description": "Canonical repository identity" },
                      "remote": { "type": "string", "description": "Deprecated. Use repo_remote_sanitized." },
                      "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
                    },
                    "required": ["commit"]
                  },
                  "description": "Claim-bearing submodule name → {path, repo_remote_sanitized, repo_remote_canonical, commit}"
                },
                "tested_submodule_pins": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string" },
                      "repo_remote_sanitized": { "type": "string" },
                      "repo_remote_canonical": { "type": "string" },
                      "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
                    },
                    "required": ["commit"]
                  },
                  "description": "Tested submodule state. Must match submodule_pins for PASS."
                },
                "test_run_id": {
                  "type": "string",
                  "description": "External runner/execution identity (e.g., GitHub Actions run ID, local test session ID)."
                },
                "validator_ko_id": {
                  "type": "string",
                  "description": "CH KnowledgeObject ID containing validation evidence. Distinct from test_run_id."
                },
                "test_command": {
                  "type": "string",
                  "description": "Exact command that was executed (e.g., 'pytest tests/ -v')."
                },
                "test_exit_code": {
                  "type": "integer",
                  "description": "Exit code of test execution. 0 = success. Required for PASS."
                },
                "test_result_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA256 of test output/report artifact. Immutable evidence hash."
                },
                "tested_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$",
                  "description": "Commit against which tests were run. Must match claim.commit for PASS."
                },
                "tested_worktree_diff_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Worktree diff SHA at test time. Must match claim.worktree_diff_sha256 when dirty."
                },
                "test_timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 timestamp of test execution."
                },
                "session_id": {
                  "type": "string",
                  "description": "CH session ID linking to the orchestration context"
                },
                "epf_ready_id": {
                  "type": "string",
                  "description": "EPF READY feature definition ID"
                }
              }
            }
          },
          "required": ["provenance_type", "implementation"]
        }
      ]
    }
  }
}
